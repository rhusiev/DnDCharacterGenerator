\newcommand{\multilinetext}[3]{%
    % #1 = line spacing (e.g., 0.8)
    % #2 = alignment (l, c, or r)
    % #3 = the text content
    {% Use a group to keep the arraystretch change local
        \renewcommand{\arraystretch}{#1}%
        \begin{tabular}{@{}#2@{}}%
            #3%
        \end{tabular}%
    }%
}

